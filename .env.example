# Copy this file to .env and fill it in. Never commit .env.
# Free Gemini key: https://aistudio.google.com/apikey
GOOGLE_API_KEY=paste-your-key-here

# Optional: Google Sheet for leads (see integrations/google_apps_script.gs)
SHEETS_WEBHOOK_URL=
SHEETS_TOKEN=

# Optional: only these sites may embed the widget (comma-separated). Empty = any site.
ALLOWED_ORIGINS=

# Optional: choose a different Gemini model
# GEMINI_CHAT_MODEL=gemini-3.5-flash-lite
